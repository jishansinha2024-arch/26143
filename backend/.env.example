# ---- Required ----
# MongoDB connection string (local mongod or an Atlas SRV URL)
MONGO_URL=mongodb://localhost:27017
DB_NAME=varuna_netra

# Secret used to sign JWT session tokens — set a long random string in production
JWT_SECRET=change-me-to-a-long-random-string

# First admin account, created on startup
ADMIN_EMAIL=admin@varuna.local
ADMIN_PASSWORD=VarunaAdmin2026x

# Base URL the frontend is served from (used in password-reset / alert emails)
FRONTEND_URL=http://localhost:3000

# ---- Demo mode (optional) ----
# When true and the demo passwords below are set, seeds labelled demo accounts
DEMO_MODE=true
DEMO_SUPERVISOR_EMAIL=supervisor@varuna.example
DEMO_SUPERVISOR_PASSWORD=change-me
DEMO_ANALYST_EMAIL=analyst@varuna.example
DEMO_ANALYST_PASSWORD=change-me

# ---- Optional integrations (safe to leave blank locally) ----
# AISSTREAM_API_KEY=
# AIS_INGEST_ENABLED=false
# OPENAI_API_KEY=
# LLM_KEY=
# RESEND_API_KEY=
# SENDER_EMAIL=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_ENV=test
# GOOGLE_AUTH_ENABLED=false
# GOOGLE_OAUTH_SESSION_URL=
# CORS_ORIGINS=http://localhost:3000
# CORS_ORIGIN_REGEX=
# OIL_MODEL_PATH=
# WEBHOOK_CRON_SECRET=
# APP_ENV=development
# ENVIRONMENT=development
